flowchart TD
  S(( )):::start --> Forgot["Click Forgot password?"]
  Forgot --> Email["Enter account email"]
  Email --> Has{"Account with a<br/>security question exists?"}
  Has -- No --> NF["Show: no account found (404)"]:::error
  NF --> Email
  Has -- Yes --> Q["Show the security question"]
  Q --> Answer["Enter answer, new password and confirmation"]
  Answer --> Rules{"New password meets the rules<br/>and confirmation matches?"}
  Rules -- No --> Answer
  Rules -- Yes --> Check{"Answer matches the stored hash<br/>(trimmed, any letter case)?"}
  Check -- No --> Wrong["Show: Security answer is incorrect"]:::error
  Wrong --> Answer
  Check -- Yes --> Save["Hash and save the new password;<br/>old password stops working"]
  Save --> Done["Show success"]:::ok
  Done --> SignIn["Return to sign-in"]
  SignIn --> E((( ))):::stop
  classDef start fill:#153A33,stroke:#153A33
  classDef stop fill:#153A33,stroke:#153A33
  classDef error fill:#FBE3E8,stroke:#A03B4F,color:#5A1E2A
  classDef ok fill:#DDF0C8,stroke:#3F6B55

PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stockit
JWT_SECRET=replace-me-with-a-long-random-string
FRONTEND_URL=http://localhost:5173

# Optional: SMTP settings for sending "forgot password" emails.
# If SMTP_HOST is left unset, reset links are logged to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockIt <no-reply@stockit.local>

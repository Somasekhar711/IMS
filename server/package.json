{
  "name": "ims-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit tests/unit",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit tests/integration",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --coverage",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "jest": "^29.7.0",
    "supertest": "^7.3.2"
  }
}
